# Python bytecode and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local editor configuration
.venv/
venv/
.idea/
.vscode/

# Training outputs, experiments, and generated caches
outputs/
checkpoints/
wandb/
tensorboard/
*.log
*.pt
*.pth
*.ckpt
*.safetensors

# Dataset and pretrained-weight locations are intentionally local.
/data/
weights/
datasets/
geometry_cache/
# Stage 2 DINO feature tensors are reproducible local caches (~2.5 GB).
/stage2/artifacts/spotting_features/**/*.npz
# Partial CV runs were superseded by the requested fixed train/validation split.
/stage2/spotting_experiments/results/*/cv/
# No broad !stage2/** exception: that re-includes checkpoints and bytecode.
# Temporal-pyramid 383-grid DINO feature cache (6.7 GB; backed up to R2 stage2/cache/temporal_pyramid_cache_383).
/stage2/temporal_pyramid_experiments/cache_383/
# Stage 3 v2 run directories (checkpoints, predictions); backed up to R2 stage3/runs/stage3_v2_2026-09-24/runs.
/runs/stage3_v2/
# Long-context v2 out-of-fold predictions (~40 MB; backed up to R2 stage2/runs/2026-09-25/long_context_v2_experiments/results).
/stage2/long_context_v2_experiments/results/**/oof_full.json
# Stage 2 feature cache manifest (the npz files are ignored above; full cache in R2 stage2/cache/fpsblind_192_7x10_349).
/stage2/artifacts/spotting_features/fpsblind_192_7x10_349/
# Stage 2 generalization feature caches (backed up to R2 stage2/runs/2026-09-26/generalization/)
/stage2/generalization/cache_*/
/stage2/objtrack/cache_*/
/stage2/generalization/cache_dense_vitb/
