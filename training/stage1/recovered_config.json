{
  "frames_manifest": "data/stage1/manifest.jsonl",
  "image_root": "data/stage1/processed",
  "output_dir": "runs/stage1/global_g1",
  "backbone": "convnext_tiny",
  "pretrained": true,
  "image_size": 224,
  "center_ratio": 0.8,
  "patch_ratio": 0.3,
  "row_bins": 64,
  "native_probability": 0.7,
  "validation_variants": [
    "native",
    "resize_h264_1280x720",
    "resize_h264_854x480",
    "resize_h264_640x360",
    "resize_h264_480x272",
    "resize_h264_420x272"
  ],
  "batch_size": 1,
  "gradient_accumulation_steps": 8,
  "epochs": 25,
  "freeze_backbone_epochs": 3,
  "backbone_learning_rate": 3e-06,
  "head_learning_rate": 0.0001,
  "weight_decay": 0.05,
  "warmup_epochs": 3,
  "early_stopping_patience": 3,
  "auxiliary_loss_weight": 0.2,
  "consistency_loss_weight": 0.2,
  "num_workers": 2,
  "seed": 42,
  "robust_cvar_k": 2,
  "partial_unfreeze_blocks": 1,
  "dropout": 0.2,
  "modality_dropout": 0.25,
  "global_height": 192,
  "global_width": 320,
  "global_auxiliary_loss_weight": 0.1
}
